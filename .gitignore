# ------------------------------
# IDE & Editor
# ------------------------------
.idea/
*.iml
.vscode/

# ------------------------------
# Node Modules (per package)
# ------------------------------
**/node_modules/

# ------------------------------
# Yarn & Pnpm
# ------------------------------
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-debug.log*

# ------------------------------
# Testing
# ------------------------------
**/coverage/

# ------------------------------
# Builds & Outputs
# ------------------------------
# Next.js (frontend)
frontend/.next/
frontend/out/

# Next.js type declarations
frontend/next-env.d.ts

# Backend build outputs
backend/build/
backend-arch/build/
backend/dist/
backend-arch/dist/

# Generic build folders
**/dist/
**/build/

# ------------------------------
# Miscellaneous
# ------------------------------
.DS_Store
*.pem

# ------------------------------
# Logs
# ------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------
# Environment Variables
# ------------------------------
# Ignore all env files in all packages
**/.env
**/.env.*
!**/.env.example

# ------------------------------
# Deployment & Hosting
# ------------------------------
.vercel
.netlify

# ------------------------------
# TypeScript
# ------------------------------
*.tsbuildinfo
