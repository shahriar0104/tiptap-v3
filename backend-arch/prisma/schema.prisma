// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================
// ENUMS
// ==========================
enum UserRole {
  ADMIN
  EDITOR
  BOARD_MEMBER
  VIEWER
}

enum BoardMeetingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AgendaItemType {
  STANDARD
  DECISION
  INFO
}

enum AgendaItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum DocumentRole {
  CONTEXT
  FIGURE
  APPENDIX
}

enum SlideKind {
  TITLE
  SUMMARY
  AGENDA_ITEM_SUMMARY
  DETAIL
}

// ==========================
// MODELS
// ==========================
model User {
  id        String   @id @db.Uuid // matches Supabase auth.users.id
  email     String   @unique
  name      String?
  avatar    String?  // Profile picture URL
  role      UserRole @default(BOARD_MEMBER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String        @db.Uuid

  uploads      Upload[]
  BoardMeeting BoardMeeting[]
  Presentation Presentation[]
}

model Organization {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  slug        String     @unique
  description String?
  domain      String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  users       User[]
  meetings    BoardMeeting[]
}

model BoardMeeting {
  id              String              @id @default(uuid()) @db.Uuid
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String            @db.Uuid
  title           String
  description     String?
  status          BoardMeetingStatus  @default(DRAFT)
  meetingDate     DateTime?
  createdBy       User?               @relation(fields: [createdById], references: [id])
  createdById     String?             @db.Uuid
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  agendaGroups    AgendaGroup[]
  presentations   Presentation[]
  contents        EditorContent[]
}

model AgendaGroup {
  id             String         @id @default(uuid()) @db.Uuid
  boardMeeting   BoardMeeting   @relation(fields: [boardMeetingId], references: [id], onDelete: Cascade)
  boardMeetingId String         @db.Uuid
  title          String
  order          Int
  startTime      DateTime       @db.Time
  status         AgendaItemStatus @default(PENDING)
  createdAt      DateTime       @default(now())

  agendaItems    AgendaItem[]

  @@unique([boardMeetingId, order])
}

model AgendaItem {
  id            String           @id @default(uuid()) @db.Uuid
  agendaGroup   AgendaGroup      @relation(fields: [agendaGroupId], references: [id], onDelete: Cascade)
  agendaGroupId String           @db.Uuid
  title         String
  order         Int
  startTime     DateTime         @db.Time
  type          AgendaItemType   @default(STANDARD)
  status        AgendaItemStatus @default(PENDING)
  createdAt     DateTime         @default(now())

  documents     AgendaItemDocument[]
  Slide         Slide[]

  @@unique([agendaGroupId, order])
}

model EditorContent {
  id             String        @id @default(uuid()) @db.Uuid
  boardMeeting   BoardMeeting  @relation(fields: [boardMeetingId], references: [id], onDelete: Cascade)
  boardMeetingId String        @db.Uuid
  contentJson    Json           // Tiptap JSON for full meeting content
  version        Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Upload {
  id           String   @id @default(uuid()) @db.Uuid
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  uploadedById String?  @db.Uuid
  fileUrl      String
  fileName     String
  mimeType     String
  createdAt    DateTime @default(now())

  agendaDocs   AgendaItemDocument[]
}

model AgendaItemDocument {
  id            String         @id @default(uuid()) @db.Uuid
  agendaItem    AgendaItem     @relation(fields: [agendaItemId], references: [id], onDelete: Cascade)
  agendaItemId  String         @db.Uuid
  upload        Upload         @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  uploadId      String         @db.Uuid
  role          DocumentRole   @default(CONTEXT)
}

// ==========================
// PRESENTATION
// ==========================
model Presentation {
  id              String       @id @default(uuid()) @db.Uuid
  boardMeeting    BoardMeeting @relation(fields: [boardMeetingId], references: [id], onDelete: Cascade)
  boardMeetingId  String      @db.Uuid
  createdBy       User?        @relation(fields: [createdById], references: [id])
  createdById     String?      @db.Uuid
  createdAt       DateTime     @default(now())

  slides          Slide[]
}

model Slide {
  id              String       @id @default(uuid()) @db.Uuid
  presentation    Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  presentationId  String      @db.Uuid
  agendaItem      AgendaItem?  @relation(fields: [agendaItemId], references: [id])
  agendaItemId    String?      @db.Uuid
  kind            SlideKind
  title           String?
  bodyJson        Json?        // JSON for slide content
  orderIndex      Int
  createdAt       DateTime     @default(now())

  @@unique([presentationId, orderIndex])
}
